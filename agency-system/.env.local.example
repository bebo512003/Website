# Find these values in Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key used by the protected Admin Team Management create/update API.
# NEVER prefix this variable with NEXT_PUBLIC and never expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL used by Supabase Auth redirect links and transactional email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the scheduled server jobs (Vercel Cron or any HTTP scheduler).
# Send as Authorization: Bearer <CRON_SECRET> to /api/cron/reminders and /api/cron/emails.
CRON_SECRET=generate-a-long-random-string

# ── Transactional email (Session 21) ──────────────────────────────────────
# Resend API key (https://resend.com/api-keys). Server-only — used by the
# /api/cron/emails job. Without it the email queue stays idle and the cron
# route returns 503.
RESEND_API_KEY=

# Webhook secret for delivery-status tracking (https://resend.com/webhooks).
# Resend signs events with this secret; POST /api/email/resend-webhook verifies
# the signature before recording delivery/bounce events. Leave empty to keep
# the webhook endpoint disabled.
RESEND_WEBHOOK_SECRET=

# Verified sender identity (Resend → Domains, or the free onboarding@resend.dev
# testing address for development). Example:
# EMAIL_FROM_ADDRESS=notifications@yourdomain.com
EMAIL_FROM_ADDRESS=

# Optional sender/brand display names (defaults shown).
EMAIL_FROM_NAME=Agency OS
EMAIL_BRAND_NAME=Agency OS

# Cloudflare Turnstile — optional bot protection for public forms.
# Get your keys at https://dash.cloudflare.com > Turnstile.
# Leave unset to disable Turnstile (the forms still work without it).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
